{
    "name": "softcomtecnologia/cpf-gratis",
    "description": "Com esse pacote você poderá consultar, gratuitamente, CPFs diretamente no site da receita.",
    "keywords": ["laravel", "cpf", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "Anderson Chaves"
        }
    ],
    "require": {
        "php": ">=8.1",
        "jansenfelipe/utils": "^v2.0.6",
        "symfony/browser-kit": "^v6.4.24"
    },
    "autoload": {
        "psr-4": {
            "AndersonAragao\\CpfGratis\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "~4.0"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "minimum-stability": "dev"
}
